      },
      {
        "type": "text",
        "content": "RFIDWedge\u652f\u6301\u6807\u7b7e\u6570\u636e\u683c\u5f0f\u5316\u3001\u53ef\u914d\u7f6e\u6807\u7b7e\u8f93\u51fa\u65b9\u5f0f\u3001\u81ea\u5b9a\u4e49rfid\u6309\u952e\u53ca\u89e6\u53d1\u6a21\u5f0f\u3001\u53ef\u5173\u8054\u5e94\u7528\uff0c\u4e0d\u540c\u5e94\u7528\u4e0d\u540c\u914d\u7f6e\u3001\u4e00\u4f53\u5f0fRFID\u8bbe\u5907\u3001\u53ef\u62c6\u5378RFID\u8bbe\u5907\u5747\u652f\u6301\u4f7f\u7528\u3002"
      },
      {
        "type": "text",
        "content": "ScanWedge\u81ea\u5b9a\u4e49\u626b\u7801\u8bbe\u7f6e"
      },
